import flixel.FlxG;
import flixel.addons.transition.FlxTransitionableState;
import flixel.addons.display.FlxRuntimeShader;
import flixel.FlxSprite;
import flixel.group.FlxGroup.FlxTypedGroup;
import flixel.group.FlxSpriteGroup;
import flixel.math.FlxMath;
import flixel.math.FlxRect;
import flixel.text.FlxText;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxAxes;
import flixel.util.FlxColor;
import flixel.util.FlxStringUtil;
import flixel.util.FlxTimer;
import funkin.Conductor;
import funkin.audio.FunkinSound;
import funkin.data.story.level.LevelRegistry;
import funkin.data.song.SongRegistry;
import funkin.graphics.FunkinSprite;
import funkin.modding.events.ScriptEvent;
import funkin.modding.events.ScriptEventDispatcher;
import funkin.play.PlayStatePlaylist;
import funkin.play.song.Song;
import funkin.save.Save;
import funkin.ui.FullScreenScaleMode;
import funkin.ui.MusicBeatState;
import funkin.ui.ScriptedMusicBeatState;
import funkin.ui.story.Level;
import funkin.ui.story.LevelProp;
import funkin.ui.story.LevelTitle;
import funkin.ui.transition.LoadingState;
import funkin.util.MathUtil;
import funkin.util.SwipeUtil;
import funkin.util.TouchUtil;
import funkin.Highscore;
import Reflect;
import Type;

/**
 * StoryMenu custom - Capa 1 + Capa 2
 *
 *  Capa 1: fondo de color, barra negra, props, LEVEL SCORE, nombre de la week, lista de weeks.
 *  Capa 2: cajas negras (tracks / dificultad), tracklist, selector de dificultad,
 *          seleccion con flechas del teclado, swipe y tap en mobile.
 *  Capa 3: blot (mancha negra) detras de los titulos de las weeks.
 *  Extra:  volver al menu principal con ESCAPE (PC) y BackButton (mobile).
 *  Jugar:  ACCEPT (PC) o tap sobre la week seleccionada (mobile) -> PlayState en story mode (como vanilla).
 *  Vis:    visualizer con mascara (images/menus/story/visulizatorMask.png) + shader propio, audio via SpectralAnalyzer.
 *  Lista:  weeks con escala/alpha segun posicion (arriba = chicas y transparentes,
 *          abajo = 0.9, seleccionada = 1.0), recortadas por arriba en el borde del blot (clipRect).
 *
 * ASSETS (poner en  images/storymenu/ui/ , o cambiar ASSET_DIR):
 *   tracks-box.png, week-diff-box.png, diff-selector.png/.xml, alphabet-white.png/.xml
 *   blot.png                          -> mancha detras de los titulos (ver BLOT_ASSET)
 *   (opcional) difficulty.png/.xml    -> sprite animado del "Difficulty:" (ver DIFF_LABEL_ASSET)
 *   Las imagenes de dificultad se cargan como en vanilla: images/storymenu/difficulties/<id>.png(.xml)
 *
 * Abrir desde otro state con:
 *   FlxG.switchState(ScriptedMusicBeatState.scriptInit('StoryMenuCustom'));
 */
class StoryMenuCustom extends MusicBeatState
{
  // ---------------------------------------------------------------------------
  // CONSTANTES AJUSTABLES (coordenadas en 1280x720, medidas sobre tu captura)
  // ---------------------------------------------------------------------------
  var ASSET_DIR:String = 'menus/story/';
  var DIFF_LABEL_ASSET:String = 'menus/story/eng/difficulty';

  // Menu al que se vuelve con ESCAPE / BackButton (clase scripteada).
  var MAIN_MENU_CLASS:String = 'NewMainMenuState';

  // zIndex (menor = mas atras). El blot queda justo detras de los titulos.
  var Z_BACKGROUND:Int = 100;   // fondo de color (la barra negra va en Z_BACKGROUND - 1)
  var Z_VIS:Int = 101;     // visualizer: encima del fondo, debajo del blot
  var Z_BLOT:Int = 102;
  var Z_TITLES:Int = 103;

  // Blot + titulos: centro X medido entre tracks-box y week-diff-box de tu captura.
  // Pon 640 en TITLES_CENTER_X si prefieres los titulos centrados en pantalla como el vanilla.
  var BLOT_ASSET:String = 'menus/story/weeks-blot';
  var BLOT_COLOR:Int = 0xFF27242A;   // color del blot (medido sobre tu captura)
  var BLOT_CENTER_X:Float = 600.0;
  var BLOT_OFFSET_Y:Float = 0.0;   // 0 = pegado al borde de abajo; negativo = mas arriba
  var TITLES_CENTER_X:Float = 600.0;
  var TITLES_SPACING:Float = 92.0;  // distancia entre centros de weeks seguidas (medida sobre tu captura: ~46 px a mitad de tamano)
  var TITLES_OFFSET_Y:Float = 0.0;  // mueve toda la lista: negativo = arriba, positivo = abajo

  // Fondo: ocupa toda la pantalla (de BACKGROUND_Y hasta abajo; la barra negra queda arriba).
  // Pon 0 si lo quieres literalmente desde el borde superior.
  var BACKGROUND_Y:Float = 56.0;

  // Lista de weeks: escala / transparencia segun su posicion respecto a la seleccionada.
  var TITLE_SELECTED_SCALE:Float = 1.0;
  var TITLE_SELECTED_ALPHA:Float = 1.0;
  var TITLE_ABOVE_SCALE:Float = 0.7;    // las de arriba: mas chicas
  var TITLE_ABOVE_ALPHA:Float = 0.3;    // ...y mas transparentes
  var TITLE_BELOW_SCALE:Float = 0.9;    // las de abajo
  var TITLE_BELOW_ALPHA:Float = 0.6;
  var TITLE_ANIM_DURATION:Float = 0.3;  // segundos que tarda la animacion (menor = mas rapido)

  // La lista se recorta desde el borde de arriba del blot hacia abajo.
  // Si no existe el blot, se recorta desde esta Y.
  var LIST_CLIP_TOP_FALLBACK:Float = 430.0;

  // Visualizer (mascara de 16 columnas x 8 filas, se muestra a tamano real 1:1).
  // Poner en images/menus/story/visulizatorMask.png (o cambiar VIS_ASSET).
  var VIS_ASSET:String = 'menus/story/visulizatorMask';
  var VIS_X:Float = 5.0;              // posicion de la esquina de arriba-izquierda (medida en tu captura)
  var VIS_Y:Float = 250.0;
  var VIS_COLUMNS:Int = 16;
  var VIS_ROWS:Int = 8;
  var VIS_CELL_PITCH_X:Float = 100.0; // separacion entre celdas en la imagen de la mascara
  var VIS_CELL_PITCH_Y:Float = 39.0;
  var VIS_ALPHA:Float = 0.41;         // opacidad de la fila de arriba (en tu captura ~0.4)
  var VIS_FADE_PER_ROW:Float = 0.17;  // cuanto se apaga cada fila hacia abajo
  var VIS_COLOR:Int = 0xFFFFFFFF;

  // ---- Pantalla ancha (FullScreenScaleMode) ----
  // En pantallas mas anchas que 16:9 (mobile) FlxG.width crece (hasta 20:9) y FlxG.height se queda en 720.
  // Todas las coordenadas de arriba estan medidas a 1280 de ancho. En create() se corrigen segun el ancho extra:
  //   - lo anclado a la IZQUIERDA (tracks-box, tracklist, visualizer) no se mueve;
  //   - lo anclado a la DERECHA (week-diff-box, flechas, label y sprite de dificultad) se mueve el ancho extra completo;
  //   - lo que esta ENTRE las dos cajas (blot + titulos de las weeks) se mueve la mitad.
  var wideShiftX:Float = 0.0;         // ancho extra en px (FlxG.width - 1280); se calcula en computeWideLayout()
  var BETWEEN_BOXES_FOLLOW:Float = 0.5;  // fraccion del ancho extra que sigue el blot/lista de weeks
  var PROPS_WIDE_SHIFT:Float = 0.25;     // fraccion del ancho extra que se mueven los props (0.25 = igual que vanilla)

  // BackButton (solo mobile)
  var BACK_BUTTON_X:Float = 10.0;
  var BACK_BUTTON_Y:Float = 64.0;

  // Texto de la fuente alphabet-white
  var GLYPH_ASCENT:Float = 46.0;   // linea base local dentro de cada texto
  var GLYPH_SPACE:Float = 18.0;    // ancho de un espacio
  var GLYPH_XHEIGHT:Float = 22.0;  // altura de una 'o' (para el guion '-')

  // Cajas negras (alineadas abajo-izquierda / abajo-derecha)
  var TRACKS_COLOR:Int = 0xFFE55777;

  // Tracks
  var TRACKS_TITLE_X:Float = 40.0;
  var TRACKS_TITLE_BASELINE:Float = 456.0;
  var TRACKS_TITLE_SPACING:Float = 8.0;
  var TRACKS_NAMES_X:Float = 17.0;
  var TRACKS_FIRST_BASELINE:Float = 551.0;
  var TRACKS_LINE_HEIGHT:Float = 45.0;

  // Dificultad
  var DIFF_CENTER_X:Float = 1060.0;
  var DIFF_CENTER_Y:Float = 651.0;
  var DIFF_LABEL_CENTER_X:Float = 1054.0;
  var DIFF_LABEL_CENTER_Y:Float = 542.0;
  var DIFF_LABEL_COLOR:Int = 0xFF33FFFF;   // solo para el texto de respaldo
  var DIFF_LABEL_SCALE:Float = 1.0;        // escala del sprite del label (el atlas mide 396x82)
  var DIFF_LABEL_FPS:Int = 24;             // velocidad de la animacion del label
  var ARROW_LEFT_X:Float = 870.0;
  var ARROW_RIGHT_X:Float = 1228.0;
  var ARROW_CENTER_Y:Float = 654.0;
  var ARROW_POINTS_LEFT:Bool = true; // si en pantalla las flechas salen al reves, ponlo en false


  // ---------------------------------------------------------------------------
  // ESTADO
  // ---------------------------------------------------------------------------
  static var rememberedLevelId:String = null;
  static var rememberedDifficulty:String = null;

  var currentLevelId:String = 'tutorial';
  var currentDifficultyId:String = 'normal';
  var currentLevel:Level = null;
  var levelList:Array<String> = [];

  var highScore:Int = 0;
  var highScoreLerp:Int = 0;

  var exitingMenu:Bool = false;
  var selectedLevel:Bool = false;
  var stickerSubState:Dynamic = null;

  var levelBackground:FlxSprite = null;
  var blot:FlxSprite = null;
  var visSprite:FlxSprite = null;
  var visShader:FlxRuntimeShader = null;
  var visAnalyzer:Dynamic = null;
  var visCache:Array<Dynamic> = [];
  var visLevels:Array<Float> = [];
  var visPack0:Array<Float> = [0.0, 0.0, 0.0, 0.0];
  var visPack1:Array<Float> = [0.0, 0.0, 0.0, 0.0];
  var visPack2:Array<Float> = [0.0, 0.0, 0.0, 0.0];
  var visPack3:Array<Float> = [0.0, 0.0, 0.0, 0.0];
  var visTime:Float = 0.0;
  var blackBar:FunkinSprite = null;
  var levelProps:FlxTypedGroup = null;
  var levelTitles:FlxTypedGroup = null;
  var currentLevelTitle:LevelTitle = null;
  var scoreText:FlxText = null;
  var levelTitleText:FlxText = null;

  // Borde de arriba del blot: las weeks se recortan por encima de esta Y (clipRect por sprite).
  var listClipTop:Float = 0.0;
  // Valores actuales / objetivo de escala y alpha de cada titulo (arrays paralelos a levelTitles).
  var titleScales:Array<Float> = [];
  var titleTargetScales:Array<Float> = [];
  var titleAlphas:Array<Float> = [];
  var titleTargetAlphas:Array<Float> = [];
  var titleClipRects:Array<FlxRect> = [];

  var alphabetFrames:Dynamic = null;
  var tracksBox:FlxSprite = null;
  var diffBox:FlxSprite = null;
  var tracksTitle:FlxSpriteGroup = null;
  var tracksGroup:FlxTypedGroup = null;

  var leftDifficultyArrow:FlxSprite = null;
  var rightDifficultyArrow:FlxSprite = null;
  var difficultyLabel:FlxSprite = null;
  var difficultySprite:FlxSprite = null;
  // Cache de sprites de dificultad (arrays paralelos, sin Map para evitar el parser de HScript).
  var diffSpriteIds:Array<String> = [];
  var diffSpriteCache:Array<FlxSprite> = [];

  // Recibe el StickerSubState al volver de una week (ResultState / GameOver / Pause), igual que vanilla.
  public function new(?stickers:Dynamic = null)
  {
    super();

    if (stickers != null && stickers.members != null)
    {
      stickerSubState = stickers;
    }
  }

  override function create():Void
  {
    super.create();

    persistentUpdate = persistentDraw = true;

    // Ajusta las posiciones segun el ancho real de la pantalla (antes de construir nada).
    computeWideLayout();

    // Musica del menu: pone el BPM en el Conductor (los props dependen de esto).
    playMenuMusic();

    // Venimos de una week: los stickers se van quitando encima del menu.
    if (stickerSubState != null)
    {
      persistentUpdate = persistentDraw = true;
      openSubState(stickerSubState);
      stickerSubState.degenStickers();
    }

    // Lista de levels visibles (igual que vanilla).
    levelList = LevelRegistry.instance.listSortedLevelIds();
    levelList = levelList.filter(function(id)
    {
      var levelData = LevelRegistry.instance.fetchEntry(id);
      if (levelData == null) return false;
      return levelData.isVisible();
    });
    if (levelList.length == 0) levelList = ['tutorial'];

    if (rememberedLevelId != null) currentLevelId = rememberedLevelId;
    if (rememberedDifficulty != null) currentDifficultyId = rememberedDifficulty;
    if (levelList.indexOf(currentLevelId) == -1) currentLevelId = levelList[0];

    alphabetFrames = Paths.getSparrowAtlas(ASSET_DIR + 'alphabet-white');

    updateData();

    // Titulos de las weeks (WEEK 1, WEEK 2...).
    levelTitles = new FlxTypedGroup();
    levelTitles.zIndex = Z_TITLES;
    add(levelTitles);

    // Fondo de color (tamano de pantalla) + barra negra de arriba.
    updateBackground();

    // Visualizer (encima del fondo, debajo del blot).
    buildVisualizer();

    // Blot detras de los titulos (capa 3).
    buildBlot();

    blackBar = new FunkinSprite(levelBackground.x, 0);
    blackBar.makeSolidColor(FlxG.width, Std.int(BACKGROUND_Y), FlxColor.BLACK);
    blackBar.zIndex = levelBackground.zIndex - 1;
    add(blackBar);

    // Props (dad / bf / gf).
    levelProps = new FlxTypedGroup();
    levelProps.zIndex = 499;
    add(levelProps);
    updateProps();

    // Cajas negras de abajo (por encima del fondo, por debajo de los props).
    tracksBox = new FlxSprite(0, 0);
    tracksBox.loadGraphic(Paths.image(ASSET_DIR + 'tracks-box'));
    tracksBox.antialiasing = true;
    tracksBox.x = 0;
    tracksBox.y = FlxG.height - tracksBox.height;
    tracksBox.zIndex = 500;
    add(tracksBox);

    diffBox = new FlxSprite(0, 0);
    diffBox.loadGraphic(Paths.image(ASSET_DIR + 'week-diff-box'));
    diffBox.antialiasing = true;
    diffBox.x = FlxG.width - diffBox.width;
    diffBox.y = FlxG.height - diffBox.height;
    diffBox.zIndex = 500;
    add(diffBox);

    // Textos de la barra superior.
    scoreText = new FlxText(Math.max(FullScreenScaleMode.gameNotchSize.x, 10), 10, 0, 'LEVEL SCORE: 0');
    scoreText.setFormat('VCR OSD Mono', 32);
    scoreText.zIndex = 1000;
    add(scoreText);

    levelTitleText = new FlxText(Math.max((FlxG.width * 0.7), FlxG.width - FullScreenScaleMode.gameNotchSize.x), 10, 0, currentLevel.getTitle());
    levelTitleText.setFormat('VCR OSD Mono', 32, FlxColor.WHITE, 'right');
    levelTitleText.alpha = 0.7;
    levelTitleText.zIndex = 1000;
    add(levelTitleText);

    buildLevelTitles();
    updateTitleSelection(true);

    // Selector de dificultad.
    buildDifficultyArrows();
    buildDifficultyLabel();
    buildDifficultySprite();

    // Tracklist + score + clamp de dificultad.
    changeDifficulty(0);
    highScoreLerp = highScore;

    refresh();

    if (FlxG.onMobile)
    {
      // BackButton nativo (existe solo en builds mobile).
      addBackButton(BACK_BUTTON_X + Math.max(FullScreenScaleMode.gameNotchSize.x - 10, 0), BACK_BUTTON_Y, FlxColor.WHITE, goBack, 0.7);

      try
      {
        FlxG.touches.swipeThreshold.y = 100;
      }
      catch (e:Dynamic) {}
    }
  }

  /**
   * Corrige las coordenadas medidas a 1280 px segun el ancho real (FullScreenScaleMode).
   * Se usa FlxG.width - FlxG.initialWidth y no FullScreenScaleMode.wideScale, porque wideScale solo se actualiza
   * cuando hay recorte y puede quedar con un valor viejo tras un resize.
   * Es seguro mutar las constantes: el state se crea de nuevo cada vez que se abre.
   */
  function computeWideLayout():Void
  {
    wideShiftX = Math.max(FlxG.width - FlxG.initialWidth, 0);
    if (wideShiftX <= 0) return;

    // Entre las dos cajas: el centro se mueve la mitad.
    BLOT_CENTER_X += wideShiftX * BETWEEN_BOXES_FOLLOW;
    TITLES_CENTER_X += wideShiftX * BETWEEN_BOXES_FOLLOW;

    // Selector de dificultad: anclado a la derecha (week-diff-box).
    DIFF_CENTER_X += wideShiftX;
    DIFF_LABEL_CENTER_X += wideShiftX;
    ARROW_LEFT_X += wideShiftX;
    ARROW_RIGHT_X += wideShiftX;
  }

  override function update(elapsed:Float):Void
  {
    // Sin esto el Conductor no avanza y los props nunca reciben beat/step.
    Conductor.instance.update();

    // Score con lerp, igual que vanilla.
    highScoreLerp = Std.int(MathUtil.snap(MathUtil.smoothLerpPrecision(highScoreLerp, highScore, elapsed, 0.307), highScore, 1));
    scoreText.text = 'LEVEL SCORE: ' + FlxStringUtil.formatMoney(highScoreLerp, false, true);

    // Titulo alineado a la derecha.
    levelTitleText.text = currentLevel.getTitle();
    levelTitleText.x = FlxG.width - (levelTitleText.width + Math.max(10, FullScreenScaleMode.gameNotchSize.x));

    handleInput();

    // Volumen de la musica (como vanilla).
    if (FlxG.sound.music != null && FlxG.sound.music.volume < 0.8)
    {
      FlxG.sound.music.volume += 0.5 * elapsed;
    }

    super.update(elapsed);

    // Despues de super.update: las weeks ya se movieron este frame, el recorte usa su Y actual.
    updateTitleVisuals(elapsed);
    updateVisualizer(elapsed);
  }

  /**
   * Los props son Boppers: necesitan que les reenviemos los eventos
   * (beat hit, etc.) para que hagan su idle al ritmo de la musica.
   */
  override function dispatchEvent(event:ScriptEvent):Void
  {
    super.dispatchEvent(event);

    if (levelProps != null && levelProps.members != null && levelProps.members.length > 0)
    {
      for (prop in levelProps.members)
      {
        ScriptEventDispatcher.callEvent(prop, event);
      }
    }
  }

  // ---------------------------------------------------------------------------
  // INPUT (teclado + swipe/tap mobile)
  // ---------------------------------------------------------------------------

  function handleInput():Void
  {
    if (exitingMenu) return;

    // Mientras el sticker esta cambiando de state no se procesa input.
    if (stickerSubState != null && stickerSubState.switchingState) return;

    // Week ya elegida: se espera la transicion al PlayState, sin mas input.
    if (selectedLevel) return;

    // Volver al menu principal: ESCAPE / BACK (PC) o BackButton (mobile, ver create()).
    if (controls.BACK_P || FlxG.keys.justPressed.ESCAPE)
    {
      goBack();
      return;
    }

    // Taps en las flechas de dificultad (mobile) o click (PC).
    var arrowRightTap:Bool = TouchUtil.pressAction(rightDifficultyArrow, null, false);
    var arrowLeftTap:Bool = TouchUtil.pressAction(leftDifficultyArrow, null, false);

    // --- Subir / bajar de level (igual que vanilla) ---------------------------
    if (controls.UI_UP_P || SwipeUtil.swipeUp)
    {
      changeLevel(-1);
      changeDifficulty(0);
    }

    if (controls.UI_DOWN_P || SwipeUtil.swipeDown)
    {
      changeLevel(1);
      changeDifficulty(0);
    }

    if (controls.FREEPLAY_JUMP_TO_TOP)
    {
      changeLevel(levelList.length);
      changeDifficulty(0);
    }

    if (controls.FREEPLAY_JUMP_TO_BOTTOM)
    {
      changeLevel(-levelList.length);
      changeDifficulty(0);
    }

    // Rueda del mouse.
    var wheelAmount:Int = Math.round(FlxMath.bound(FlxG.mouse.deltaWheel.y, -1, 1));
    if (wheelAmount != 0)
    {
      changeLevel(-wheelAmount);
      changeDifficulty(0);
    }

    // --- Dificultad: teclado, swipe horizontal (mobile) y flechas -------------
    var flatSwipe:Bool = false;
    if (FlxG.onMobile)
    {
      flatSwipe = TouchUtil.touch != null && TouchUtil.touch.deltaViewY < 10 && TouchUtil.touch.deltaViewY > -10;
    }

    var right:Bool = controls.UI_RIGHT_P || arrowRightTap || (FlxG.onMobile && SwipeUtil.swipeRight && flatSwipe);
    var left:Bool = controls.UI_LEFT_P || arrowLeftTap || (FlxG.onMobile && SwipeUtil.swipeLeft && flatSwipe);

    if (right)
    {
      if (FlxG.onMobile && !arrowRightTap) resetTouchStart();
      changeDifficulty(1);
    }
    if (left)
    {
      if (FlxG.onMobile && !arrowLeftTap) resetTouchStart();
      changeDifficulty(-1);
    }

    // Entrar a la week (PC / gamepad).
    if (controls.ACCEPT_P)
    {
      selectLevel();
      return;
    }

    // Animacion de las flechas: blanca mientras se mantiene presionada.
    var rightHeld:Bool = controls.UI_RIGHT || (TouchUtil.pressed && TouchUtil.overlaps(rightDifficultyArrow));
    var leftHeld:Bool = controls.UI_LEFT || (TouchUtil.pressed && TouchUtil.overlaps(leftDifficultyArrow));
    rightDifficultyArrow.animation.play(rightHeld ? 'press' : 'idle');
    leftDifficultyArrow.animation.play(leftHeld ? 'press' : 'idle');

    // --- Tap en un titulo de week (solo mobile): selecciona esa week ----------
    // (Tap sobre la week ya seleccionada = entrar al nivel.)
    if (FlxG.onMobile && TouchUtil.justReleased && !TouchUtil.overlaps(leftDifficultyArrow) && !TouchUtil.overlaps(rightDifficultyArrow)
      && !SwipeUtil.justSwipedAny)
    {
      // Solo cuenta si el toque cae dentro de la zona visible de la lista.
      var insideList:Bool = TouchUtil.touch != null && TouchUtil.touch.viewY >= listClipTop;
      if (insideList)
      {
        var selectedIndex:Int = levelList.indexOf(currentLevelId);
        for (i in 0...levelTitles.members.length)
        {
          var item = levelTitles.members[i];
          if (!TouchUtil.pressAction(item, null, false)) continue;
          if (i == selectedIndex)
          {
            // Tap sobre la week ya seleccionada: entra al nivel (igual que vanilla).
            selectLevel();
            return;
          }

          changeLevel(i - selectedIndex);
          changeDifficulty(0);
        }
      }
    }
  }

  /**
   * Igual que vanilla: tras un swipe horizontal se reinicia el origen vertical del toque
   * para que no se dispare tambien un swipe vertical.
   */
  function resetTouchStart():Void
  {
    try
    {
      if (TouchUtil.touch != null) TouchUtil.touch._startY = TouchUtil.touch.viewY;
    }
    catch (e:Dynamic) {}
  }

  // ---------------------------------------------------------------------------
  // ENTRAR AL NIVEL (copia de StoryMenuState.selectLevel)
  // ---------------------------------------------------------------------------

  function selectLevel():Void
  {
    if (!currentLevel.isUnlocked())
    {
      FunkinSound.playOnce(Paths.sound('cancelMenu'));
      return;
    }

    if (selectedLevel) return;

    selectedLevel = true;

    FunkinSound.playOnce(Paths.sound('confirmMenu'));

    // La week parpadea y los props hacen su animacion de confirmar.
    if (currentLevelTitle != null) currentLevelTitle.isFlashing = true;

    for (prop in levelProps.members)
    {
      prop.playConfirm();
    }

    Paths.setCurrentLevel(currentLevel.id);

    PlayStatePlaylist.playlistSongIds = currentLevel.getSongs();
    PlayStatePlaylist.isStoryMode = true;
    PlayStatePlaylist.campaignScore = 0;

    var targetSongId:String = PlayStatePlaylist.playlistSongIds.shift();
    var targetSong:Song = SongRegistry.instance.fetchEntry(targetSongId, {variation: Constants.DEFAULT_VARIATION});

    PlayStatePlaylist.campaignId = currentLevel.id;
    PlayStatePlaylist.campaignTitle = currentLevel.getTitle();
    PlayStatePlaylist.campaignDifficulty = currentDifficultyId;

    // Reinicia los tallies de la week. Tallies es un abstract sobre una estructura, asi que
    // no se puede instanciar desde script: se ponen a cero sus campos (mismos valores que new Tallies()).
    var t = Highscore.talliesLevel;
    t.combo = 0;
    t.missed = 0;
    t.shit = 0;
    t.bad = 0;
    t.good = 0;
    t.sick = 0;
    t.totalNotes = 0;
    t.totalNotesHit = 0;
    t.maxCombo = 0;
    t.score = 0;
    t.isNewHighscore = false;

    new FlxTimer().start(1, function(tmr:FlxTimer)
    {
      // Mobile: el BackButton se desvanece.
      if (FlxG.onMobile && backButton != null)
      {
        FlxTween.tween(backButton, {alpha: 0}, 0.2, {ease: FlxEase.quadOut});
      }

      FlxTransitionableState.skipNextTransIn = false;
      FlxTransitionableState.skipNextTransOut = false;

      var targetVariation:String = targetSong.getFirstValidVariation(PlayStatePlaylist.campaignDifficulty);

      FlxG.camera.fade(FlxColor.BLACK, 0.2, false, function()
      {
        LoadingState.loadPlayState({
          targetSong: targetSong,
          targetDifficulty: PlayStatePlaylist.campaignDifficulty,
          targetVariation: targetVariation
        }, true);
      });
    });
  }

  // ---------------------------------------------------------------------------
  // VOLVER AL MENU PRINCIPAL
  // ---------------------------------------------------------------------------

  function goBack():Void
  {
    if (exitingMenu || selectedLevel) return;
    exitingMenu = true;

    FunkinSound.playOnce(Paths.sound('cancelMenu'));
    FlxG.switchState(function()
    {
      return ScriptedMusicBeatState.scriptInit(MAIN_MENU_CLASS);
    });
  }

  // ---------------------------------------------------------------------------
  // VISUALIZER (mascara + shader)
  // ---------------------------------------------------------------------------

  /**
   * Shader del visualizer. Usa el alfa de la mascara para saber donde estan los huecos
   * entre celdas (alfa ~1 = hueco, no se dibuja) y prende las filas de cada columna
   * de abajo hacia arriba segun su nivel (0..1). Los 16 niveles llegan empaquetados
   * en 4 vec4 (lv0..lv3).
   */
  function visFragmentSource():String
  {
    var src:String = '';
    src += '#pragma header\n';
    src += 'uniform vec4 lv0;\n';
    src += 'uniform vec4 lv1;\n';
    src += 'uniform vec4 lv2;\n';
    src += 'uniform vec4 lv3;\n';
    src += 'uniform vec2 maskSize;\n';
    src += 'uniform vec2 cellPitch;\n';
    src += 'uniform float rowsCount;\n';
    src += 'uniform float visAlpha;\n';
    src += 'uniform float fadePerRow;\n';
    src += 'uniform vec3 visColor;\n';
    src += 'float levelAt(float c)\n';
    src += '{\n';
    src += '  if (c < 4.0)\n';
    src += '  {\n';
    src += '    if (c < 1.0) return lv0.x;\n';
    src += '    if (c < 2.0) return lv0.y;\n';
    src += '    if (c < 3.0) return lv0.z;\n';
    src += '    return lv0.w;\n';
    src += '  }\n';
    src += '  if (c < 8.0)\n';
    src += '  {\n';
    src += '    if (c < 5.0) return lv1.x;\n';
    src += '    if (c < 6.0) return lv1.y;\n';
    src += '    if (c < 7.0) return lv1.z;\n';
    src += '    return lv1.w;\n';
    src += '  }\n';
    src += '  if (c < 12.0)\n';
    src += '  {\n';
    src += '    if (c < 9.0) return lv2.x;\n';
    src += '    if (c < 10.0) return lv2.y;\n';
    src += '    if (c < 11.0) return lv2.z;\n';
    src += '    return lv2.w;\n';
    src += '  }\n';
    src += '  if (c < 13.0) return lv3.x;\n';
    src += '  if (c < 14.0) return lv3.y;\n';
    src += '  if (c < 15.0) return lv3.z;\n';
    src += '  return lv3.w;\n';
    src += '}\n';
    src += 'void main()\n';
    src += '{\n';
    src += '  vec2 uv = openfl_TextureCoordv;\n';
    src += '  vec4 m = texture2D(bitmap, uv);\n';
    src += '  vec2 px = uv * maskSize;\n';
    src += '  float c = clamp(floor(px.x / cellPitch.x), 0.0, 15.0);\n';
    src += '  float r = clamp(floor(px.y / cellPitch.y), 0.0, rowsCount - 1.0);\n';
    src += '  float rowFromBottom = rowsCount - 1.0 - r;\n';
    src += '  float lit = floor(levelAt(c) * rowsCount + 0.5);\n';
    src += '  float on = step(rowFromBottom + 0.5, lit);\n';
    src += '  float cell = 1.0 - smoothstep(0.85, 1.0, m.a);\n';
    src += '  float fade = max(1.0 - fadePerRow * r, 0.2);\n';
    src += '  float a = cell * on * fade * visAlpha * openfl_Alphav;\n';
    src += '  gl_FragColor = vec4(visColor * a, a);\n';
    src += '}\n';
    return src;
  }

  function buildVisualizer():Void
  {
    var i:Int = 0;
    while (i < 16)
    {
      visLevels[i] = 0.0;
      i += 1;
    }

    if (!Assets.exists(Paths.image(VIS_ASSET)))
    {
      trace('[StoryMenuCustom] No se encontro la mascara del visualizer: ' + VIS_ASSET + ' (se omite).');
      return;
    }

    visSprite = new FlxSprite(VIS_X, VIS_Y);
    visSprite.loadGraphic(Paths.image(VIS_ASSET));
    visSprite.antialiasing = true;
    visSprite.zIndex = Z_VIS;

    try
    {
      visShader = new FlxRuntimeShader(visFragmentSource());
      visShader.setFloatArray('maskSize', [visSprite.frameWidth, visSprite.frameHeight]);
      visShader.setFloatArray('cellPitch', [VIS_CELL_PITCH_X, VIS_CELL_PITCH_Y]);
      visShader.setFloat('rowsCount', VIS_ROWS);
      visShader.setFloat('visAlpha', VIS_ALPHA);
      visShader.setFloat('fadePerRow', VIS_FADE_PER_ROW);
      visShader.setFloatArray('visColor', [((VIS_COLOR >> 16) & 0xFF) / 255.0, ((VIS_COLOR >> 8) & 0xFF) / 255.0, (VIS_COLOR & 0xFF) / 255.0]);
      visShader.setFloatArray('lv0', visPack0);
      visShader.setFloatArray('lv1', visPack1);
      visShader.setFloatArray('lv2', visPack2);
      visShader.setFloatArray('lv3', visPack3);
      Reflect.setProperty(visSprite, 'shader', visShader);
    }
    catch (e:Dynamic)
    {
      trace('[StoryMenuCustom] No se pudo crear el shader del visualizer: ' + e);
      visShader = null;
      visSprite.visible = false;
    }

    add(visSprite);
    initVisAnalyzer();
  }

  /**
   * Analizador de espectro de la musica del menu (el mismo que usa A-Bot).
   * Se resuelve por nombre para que el script no falle al cargar si la clase no esta disponible;
   * si no se puede crear, el visualizer usa una animacion de respaldo.
   */
  function initVisAnalyzer():Void
  {
    visAnalyzer = null;

    try
    {
      var music = FlxG.sound.music;
      if (music == null) return;

      var analyzerClass = Type.resolveClass('funkin.vis.dsp.SpectralAnalyzer');
      if (analyzerClass == null) return;

      // _channel.__audioSource es privado: se lee con Reflect (igual que hace A-Bot con @:privateAccess).
      var channel = Reflect.getProperty(music, '_channel');
      if (channel == null) return;
      var source = Reflect.getProperty(channel, '__audioSource');
      if (source == null) return;

      visAnalyzer = Type.createInstance(analyzerClass, [source, VIS_COLUMNS, 0.1, 40]);
      visAnalyzer.minDb = -65;
      visAnalyzer.maxDb = -25;
      visAnalyzer.maxFreq = 22000;
      visAnalyzer.minFreq = 10;
      visAnalyzer.fftN = 256;
    }
    catch (e:Dynamic)
    {
      trace('[StoryMenuCustom] SpectralAnalyzer no disponible, uso animacion de respaldo: ' + e);
      visAnalyzer = null;
    }
  }

  /**
   * Llena visLevels (16 valores 0..1): del analizador si existe, si no con una onda de respaldo.
   */
  function readVisLevels():Void
  {
    var gotReal:Bool = false;

    if (visAnalyzer != null)
    {
      try
      {
        if (FlxG.sound.volume == 0 || FlxG.sound.muted)
        {
          var z:Int = 0;
          while (z < 16)
          {
            visLevels[z] = 0.0;
            z += 1;
          }
        }
        else
        {
          visCache = visAnalyzer.getLevels(visCache);
          var n:Int = visCache.length;
          if (n > 16) n = 16;
          var k:Int = 0;
          while (k < n)
          {
            visLevels[k] = visCache[k].value;
            k += 1;
          }
        }
        gotReal = true;
      }
      catch (e:Dynamic)
      {
        visAnalyzer = null;
      }
    }

    if (!gotReal)
    {
      var j:Int = 0;
      while (j < 16)
      {
        var v:Float = 0.4 + 0.3 * Math.sin(visTime * 2.2 + j * 0.55) + 0.2 * Math.sin(visTime * 5.1 + j * 1.3);
        visLevels[j] = Math.max(0.0, Math.min(1.0, v));
        j += 1;
      }
    }
  }

  function updateVisualizer(elapsed:Float):Void
  {
    if (visSprite == null || visShader == null) return;

    visTime += elapsed;
    readVisLevels();

    var i:Int = 0;
    while (i < 4)
    {
      visPack0[i] = visLevels[i];
      visPack1[i] = visLevels[4 + i];
      visPack2[i] = visLevels[8 + i];
      visPack3[i] = visLevels[12 + i];
      i += 1;
    }

    visShader.setFloatArray('lv0', visPack0);
    visShader.setFloatArray('lv1', visPack1);
    visShader.setFloatArray('lv2', visPack2);
    visShader.setFloatArray('lv3', visPack3);
  }

  // ---------------------------------------------------------------------------
  // BLOT (capa 3)
  // ---------------------------------------------------------------------------

  function buildBlot():Void
  {
    listClipTop = LIST_CLIP_TOP_FALLBACK;

    if (!Assets.exists(Paths.image(BLOT_ASSET)))
    {
      trace('[StoryMenuCustom] No se encontro el blot: ' + BLOT_ASSET + ' (se omite).');
      return;
    }

    blot = new FlxSprite(0, 0);
    blot.loadGraphic(Paths.image(BLOT_ASSET));
    blot.antialiasing = true;
    blot.x = BLOT_CENTER_X - blot.width / 2;
    blot.y = FlxG.height - blot.height + BLOT_OFFSET_Y;
    blot.color = BLOT_COLOR;
    blot.zIndex = Z_BLOT;
    add(blot);

    // El recorte de la lista empieza en el borde de arriba del blot.
    listClipTop = blot.y;
  }

  // ---------------------------------------------------------------------------
  // CAMBIO DE LEVEL / DIFICULTAD
  // ---------------------------------------------------------------------------

  function changeLevel(change:Int = 0):Void
  {
    var currentIndex:Int = levelList.indexOf(currentLevelId);
    var prevIndex:Int = currentIndex;

    currentIndex += change;

    if (FlxG.onMobile)
    {
      // Con touch no se da la vuelta (igual que vanilla).
      if (currentIndex < 0) currentIndex = 0;
      if (currentIndex >= levelList.length) currentIndex = levelList.length - 1;
    }
    else
    {
      // En PC se da la vuelta.
      if (currentIndex < 0) currentIndex = levelList.length - 1;
      if (currentIndex >= levelList.length) currentIndex = 0;
    }

    if (currentIndex != prevIndex) FunkinSound.playOnce(Paths.sound('scrollMenu'), 0.4);

    setLevel(levelList[currentIndex]);
  }

  /**
   * Cambia de week (con transicion de fondo y props) y actualiza tracklist/score.
   */
  function setLevel(newLevelId:String):Void
  {
    var previousLevelId:String = currentLevelId;
    currentLevelId = newLevelId;
    rememberedLevelId = currentLevelId;

    updateData();
    updateTitleSelection();
    updateBackground(previousLevelId);
    updateProps();
    updateTracks();
    updateScore();
    refresh();
  }

  function changeDifficulty(change:Int = 0):Void
  {
    var all:Array<String> = currentLevel.getDifficulties();
    var difficultyList:Array<String> = all.filter(function(e)
    {
      return Constants.DEFAULT_DIFFICULTY_LIST.indexOf(e) != -1;
    });
    if (difficultyList.length == 0) difficultyList = all;

    var currentIndex:Int = difficultyList.indexOf(currentDifficultyId);
    if (currentIndex < 0)
    {
      currentIndex = difficultyList.indexOf(Constants.DEFAULT_DIFFICULTY);
      if (currentIndex < 0) currentIndex = 0;
    }

    currentIndex += change;
    if (currentIndex < 0) currentIndex = difficultyList.length - 1;
    if (currentIndex >= difficultyList.length) currentIndex = 0;

    var hasChanged:Bool = currentDifficultyId != difficultyList[currentIndex];
    currentDifficultyId = difficultyList[currentIndex];
    rememberedDifficulty = currentDifficultyId;

    var showArrows:Bool = difficultyList.length > 1;
    leftDifficultyArrow.visible = showArrows;
    rightDifficultyArrow.visible = showArrows;

    if (hasChanged)
    {
      buildDifficultySprite();
      FunkinSound.playOnce(Paths.sound('scrollMenu'), 0.4);
    }

    updateTracks();
    updateScore();
    refresh();
  }

  // ---------------------------------------------------------------------------
  // TEXTO CON LA FUENTE alphabet-white
  // ---------------------------------------------------------------------------

  function glyphDescender(ch:String):Float
  {
    if (ch == 'p' || ch == 'q' || ch == 'y') return 22.0;
    if (ch == 'g') return 10.0;
    if (ch == 'j') return 12.0;
    if (ch == ',') return 6.0;
    if (ch == ';' || ch == '(' || ch == ')') return 8.0;
    return 0.0;
  }

  /**
   * Arma un texto con el atlas alphabet-white. La linea base queda en
   * y = GLYPH_ASCENT * scale dentro del grupo (grupo en 0,0 al construirlo).
   * Caracteres que no existan en el atlas (como el apostrofe) se dejan en blanco.
   */
  function buildText(text:String, scale:Float, color:Int, spacing:Float):FlxSpriteGroup
  {
    var group:FlxSpriteGroup = new FlxSpriteGroup();
    var cursor:Float = 0;

    for (i in 0...text.length)
    {
      var ch:String = text.charAt(i);

      if (ch == ' ')
      {
        cursor += GLYPH_SPACE * scale;
        continue;
      }

      var g:FlxSprite = new FlxSprite();
      g.frames = alphabetFrames;
      g.animation.addByPrefix('g', ch + '0000', 24, false);

      if (!g.animation.exists('g'))
      {
        g.destroy();
        cursor += GLYPH_SPACE * scale;
        continue;
      }

      g.animation.play('g');
      g.scale.set(scale, scale);
      g.updateHitbox();
      g.antialiasing = true;
      g.color = color;

      var gy:Float = GLYPH_ASCENT * scale - g.height + glyphDescender(ch) * scale;
      if (ch == '-') gy = GLYPH_ASCENT * scale - GLYPH_XHEIGHT * scale * 0.5 - g.height * 0.5;

      g.x = cursor;
      g.y = gy;
      cursor += g.width + spacing;

      group.add(g);
    }

    return group;
  }

  // ---------------------------------------------------------------------------
  // TRACKLIST
  // ---------------------------------------------------------------------------

  function updateTracks():Void
  {
    if (tracksTitle == null)
    {
      tracksTitle = buildText('TRACKS', 1.0, TRACKS_COLOR, TRACKS_TITLE_SPACING);
      tracksTitle.x = TRACKS_TITLE_X;
      tracksTitle.y = TRACKS_TITLE_BASELINE - GLYPH_ASCENT;
      tracksTitle.zIndex = 1100;
      add(tracksTitle);
    }

    if (tracksGroup != null)
    {
      remove(tracksGroup, true);
      tracksGroup.destroy();
    }

    tracksGroup = new FlxTypedGroup();
    tracksGroup.zIndex = 1100;

    var names:Array<String> = currentLevel.getSongDisplayNames(currentDifficultyId);
    for (i in 0...names.length)
    {
      var line:FlxSpriteGroup = buildText(names[i], 1.0, TRACKS_COLOR, 0);
      line.x = TRACKS_NAMES_X;
      line.y = TRACKS_FIRST_BASELINE + (i * TRACKS_LINE_HEIGHT) - GLYPH_ASCENT;
      tracksGroup.add(line);
    }

    add(tracksGroup);
  }

  // ---------------------------------------------------------------------------
  // SELECTOR DE DIFICULTAD
  // ---------------------------------------------------------------------------

  function buildDifficultyArrows():Void
  {
    leftDifficultyArrow = new FlxSprite(ARROW_LEFT_X, 0);
    leftDifficultyArrow.frames = Paths.getSparrowAtlas(ASSET_DIR + 'diff-selector');
    // Frames 0-1: cyan (reposo). Frames 4-5: blanca (presionada).
    leftDifficultyArrow.animation.addByIndices('idle', 'difficulty arrow', [0], '', 24, true);
    leftDifficultyArrow.animation.addByIndices('press', 'difficulty arrow', [4], '', 24, true);
    leftDifficultyArrow.animation.play('idle');
    leftDifficultyArrow.antialiasing = true;
    leftDifficultyArrow.flipX = !ARROW_POINTS_LEFT;
    leftDifficultyArrow.y = ARROW_CENTER_Y - leftDifficultyArrow.height / 2;
    leftDifficultyArrow.zIndex = 1100;
    add(leftDifficultyArrow);

    rightDifficultyArrow = new FlxSprite(ARROW_RIGHT_X, 0);
    rightDifficultyArrow.frames = leftDifficultyArrow.frames;
    rightDifficultyArrow.animation.addByIndices('idle', 'difficulty arrow', [0], '', 24, true);
    rightDifficultyArrow.animation.addByIndices('press', 'difficulty arrow', [4], '', 24, true);
    rightDifficultyArrow.animation.play('idle');
    rightDifficultyArrow.antialiasing = true;
    rightDifficultyArrow.flipX = ARROW_POINTS_LEFT;
    rightDifficultyArrow.y = ARROW_CENTER_Y - rightDifficultyArrow.height / 2;
    rightDifficultyArrow.zIndex = 1100;
    add(rightDifficultyArrow);
  }

  /**
   * "Difficulty:" -> sprite animado (atlas Sparrow DIFF_LABEL_ASSET .png + .xml,
   * frames "difficulty text0000"...). Si el atlas no existe, lo dibuja con
   * alphabet-white en cyan como respaldo.
   */
  function buildDifficultyLabel():Void
  {
    if (Assets.exists(Paths.file('images/' + DIFF_LABEL_ASSET + '.xml')) && Assets.exists(Paths.image(DIFF_LABEL_ASSET)))
    {
      difficultyLabel = new FlxSprite(0, 0);
      difficultyLabel.frames = Paths.getSparrowAtlas(DIFF_LABEL_ASSET);
      difficultyLabel.animation.addByPrefix('idle', 'difficulty text', DIFF_LABEL_FPS, true);
      difficultyLabel.animation.play('idle');
      difficultyLabel.antialiasing = true;
      difficultyLabel.scale.set(DIFF_LABEL_SCALE, DIFF_LABEL_SCALE);
      difficultyLabel.updateHitbox();
    }
    else
    {
      trace('[StoryMenuCustom] No se encontro el atlas del label: ' + DIFF_LABEL_ASSET + ' (uso texto de respaldo).');
      difficultyLabel = buildText('Difficulty:', 1.2, DIFF_LABEL_COLOR, 0);
    }

    difficultyLabel.x = DIFF_LABEL_CENTER_X - difficultyLabel.width / 2;
    difficultyLabel.y = DIFF_LABEL_CENTER_Y - difficultyLabel.height / 2;
    difficultyLabel.zIndex = 1100;
    add(difficultyLabel);
  }

  /**
   * Colores de respaldo (solo si no existe la imagen de esa dificultad).
   */
  function fallbackDifficultyColor(diff:String):Int
  {
    if (diff == 'easy') return 0xFF00FF00;
    if (diff == 'normal') return 0xFFFFE600;
    if (diff == 'hard') return 0xFFFF0000;
    return 0xFFFFFFFF;
  }

  /**
   * Imagen de la dificultad actual (copia de vanilla: images/storymenu/difficulties/<id>).
   * Si no existe ni .png ni .xml, dibuja el nombre con alphabet-white.
   */
  function buildDifficultySprite():Void
  {
    if (difficultySprite != null) remove(difficultySprite);

    var diff:String = currentDifficultyId;
    var cacheIndex:Int = diffSpriteIds.indexOf(diff);
    difficultySprite = (cacheIndex != -1) ? diffSpriteCache[cacheIndex] : null;

    if (difficultySprite == null)
    {
      var basePath:String = 'storymenu/difficulties/' + diff;

      if (Assets.exists(Paths.file('images/' + basePath + '.xml')))
      {
        difficultySprite = new FlxSprite(0, 0);
        difficultySprite.frames = Paths.getSparrowAtlas(basePath);
        difficultySprite.animation.addByPrefix('idle', 'idle0', 24, true);
        if (Preferences.flashingLights) difficultySprite.animation.play('idle');
        difficultySprite.antialiasing = true;
      }
      else if (Assets.exists(Paths.image(basePath)))
      {
        difficultySprite = new FlxSprite(0, 0);
        difficultySprite.loadGraphic(Paths.image(basePath));
        difficultySprite.antialiasing = true;
      }
      else
      {
        difficultySprite = buildText(diff.toUpperCase(), 1.4, fallbackDifficultyColor(diff), 0);
      }

      difficultySprite.x = DIFF_CENTER_X - difficultySprite.width / 2;
      difficultySprite.zIndex = 1100;
      diffSpriteIds.push(diff);
      diffSpriteCache.push(difficultySprite);
    }

    var targetY:Float = DIFF_CENTER_Y - difficultySprite.height / 2;

    FlxTween.cancelTweensOf(difficultySprite);
    difficultySprite.alpha = 0;
    difficultySprite.y = targetY - 15;
    FlxTween.tween(difficultySprite, {y: targetY, alpha: 1}, 0.07);

    add(difficultySprite);
  }

  // ---------------------------------------------------------------------------
  // LEVEL TITLES (copia del vanilla)
  // ---------------------------------------------------------------------------

  function playMenuMusic():Void
  {
    FunkinSound.playMusic('freakyMenu', {
      overrideExisting: true,
      restartTrack: false,
      persist: true
    });
  }

  function buildLevelTitles():Void
  {
    levelTitles.clear();
    titleScales = [];
    titleTargetScales = [];
    titleAlphas = [];
    titleTargetAlphas = [];
    titleClipRects = [];

    for (levelIndex in 0...levelList.length)
    {
      var levelId:String = levelList[levelIndex];
      var level:Level = LevelRegistry.instance.fetchEntry(levelId);
      if (level == null || !level.isVisible()) continue;

      var item:LevelTitle = new LevelTitle(0, Std.int(levelBackground.y + levelBackground.height + 10), level);
      item.targetY = ((item.height + 20) * levelIndex);
      item.x = TITLES_CENTER_X - item.width / 2;
      levelTitles.add(item);

      var n:Int = titleScales.length;
      titleScales[n] = TITLE_BELOW_SCALE;
      titleTargetScales[n] = TITLE_BELOW_SCALE;
      titleAlphas[n] = TITLE_BELOW_ALPHA;
      titleTargetAlphas[n] = TITLE_BELOW_ALPHA;
      titleClipRects[n] = new FlxRect(0, 0, 1, 1);
    }
  }

  /**
   * Define el estado de cada week segun su posicion respecto a la seleccionada:
   *   seleccionada -> escala 1.0, alpha 1.0
   *   arriba       -> mas chica y transparente
   *   abajo        -> escala 0.9
   * Con snap = true se aplica al instante (sin animacion).
   */
  function updateTitleSelection(?snap:Bool = false):Void
  {
    var currentIndex:Int = levelList.indexOf(currentLevelId);

    for (index in 0...levelTitles.members.length)
    {
      var item:LevelTitle = levelTitles.members[index];
      var sc:Float = TITLE_BELOW_SCALE;
      var al:Float = TITLE_BELOW_ALPHA;

      if (index == currentIndex)
      {
        currentLevelTitle = item;
        sc = TITLE_SELECTED_SCALE;
        al = TITLE_SELECTED_ALPHA;
      }
      else if (index < currentIndex)
      {
        sc = TITLE_ABOVE_SCALE;
        al = TITLE_ABOVE_ALPHA;
      }

      titleTargetScales[index] = sc;
      titleTargetAlphas[index] = al;

      if (snap)
      {
        titleScales[index] = sc;
        titleAlphas[index] = al;
        applyTitleVisual(item, sc, al);
      }
    }

    repositionTitles();

    if (snap)
    {
      // Al abrir el menu las weeks aparecen ya en su lugar (sin deslizarse desde abajo).
      for (index in 0...levelTitles.members.length)
      {
        levelTitles.members[index].y = levelTitles.members[index].targetY;
      }
      updateTitleVisuals(0.0);
    }
  }

  /**
   * Anima escala y alpha de los titulos hacia su objetivo (cada frame).
   */
  function updateTitleVisuals(elapsed:Float):Void
  {
    if (levelTitles == null || levelTitles.members == null) return;

    var count:Int = levelTitles.members.length;
    var i:Int = 0;
    while (i < count)
    {
      if (i >= titleScales.length) break;

      var item:LevelTitle = levelTitles.members[i];
      var sc:Float = MathUtil.smoothLerpPrecision(titleScales[i], titleTargetScales[i], elapsed, TITLE_ANIM_DURATION);
      var al:Float = MathUtil.smoothLerpPrecision(titleAlphas[i], titleTargetAlphas[i], elapsed, TITLE_ANIM_DURATION);
      titleScales[i] = sc;
      titleAlphas[i] = al;

      if (item != null)
      {
        applyTitleVisual(item, sc, al);
        clipTitle(item, i, sc);
      }
      i += 1;
    }
  }

  /**
   * Recorta la week por arriba en listClipTop (coordenadas de pantalla).
   * clipRect va en pixeles del frame (sin escala), por eso se convierte con la escala actual.
   * Si queda completamente por encima del borde, se oculta.
   */
  function clipTitle(item:LevelTitle, index:Int, sc:Float):Void
  {
    // El primer miembro del grupo es la imagen de la week (el segundo es el candado, oculto).
    var spr:FlxSprite = item.members[0];
    if (spr == null) return;

    var rect:FlxRect = titleClipRects[index];
    var h:Float = spr.frameHeight;
    var w:Float = spr.frameWidth;

    // Y de pantalla del borde de arriba del sprite ya escalado (escala desde su origen).
    var drawnTop:Float = spr.y - spr.offset.y + spr.origin.y * (1.0 - sc);
    var localTop:Float = (listClipTop - drawnTop) / sc;

    if (localTop <= 0)
    {
      // Todo por debajo del borde: sin recorte.
      if (spr.clipRect != null) spr.clipRect = null;
      spr.visible = true;
    }
    else if (localTop >= h)
    {
      // Todo por encima del borde: no se ve.
      if (spr.clipRect != null) spr.clipRect = null;
      spr.visible = false;
    }
    else
    {
      rect.set(0, localTop, w, h - localTop);
      spr.clipRect = rect;
      spr.visible = true;
    }
  }

  /**
   * La escala se aplica a cada sprite del grupo (escalan desde su centro, asi la week
   * queda centrada). El alpha del grupo no puede llegar a 0 (el setter escala proporcional).
   */
  function applyTitleVisual(item:LevelTitle, sc:Float, al:Float):Void
  {
    var parts = item.members;
    var k:Int = 0;
    while (k < parts.length)
    {
      if (parts[k] != null) parts[k].scale.set(sc, sc);
      k += 1;
    }

    if (al < 0.02) al = 0.02;
    item.alpha = al;
  }

  function repositionTitles():Void
  {
    var currentIndex:Int = levelList.indexOf(currentLevelId);
    var count:Int = levelTitles.members.length;

    // La week seleccionada queda centrada (en vertical) dentro del blot.
    var centerY:Float = listClipTop + (FlxG.height - listClipTop) / 2;
    if (blot != null) centerY = blot.y + blot.height / 2;
    centerY += TITLES_OFFSET_Y;

    var selected:LevelTitle = levelTitles.members[currentIndex];
    selected.targetY = centerY - selected.height / 2;

    // Las de arriba: distancia fija entre centros (TITLES_SPACING), igual que en la captura.
    var i:Int = currentIndex - 1;
    while (i >= 0)
    {
      var item:LevelTitle = levelTitles.members[i];
      var nextItem:LevelTitle = levelTitles.members[i + 1];
      var nextCenter:Float = nextItem.targetY + nextItem.height / 2;
      var dist:Float = TITLES_SPACING;
      item.targetY = (nextCenter - dist) - item.height / 2;
      i -= 1;
    }

    // Las de abajo.
    i = currentIndex + 1;
    while (i < count)
    {
      var item2:LevelTitle = levelTitles.members[i];
      var prevItem:LevelTitle = levelTitles.members[i - 1];
      var prevCenter:Float = prevItem.targetY + prevItem.height / 2;
      var dist2:Float = TITLES_SPACING;
      item2.targetY = (prevCenter + dist2) - item2.height / 2;
      i += 1;
    }
  }

  // ---------------------------------------------------------------------------
  // DATA
  // ---------------------------------------------------------------------------

  function updateData():Void
  {
    currentLevel = LevelRegistry.instance.fetchEntry(currentLevelId);
    if (currentLevel == null) throw 'Could not fetch data for level: ' + currentLevelId;
  }

  function updateScore():Void
  {
    var levelScore = Save.instance.getLevelScore(currentLevelId, currentDifficultyId);
    highScore = (levelScore != null) ? levelScore.score : 0;
  }

  // ---------------------------------------------------------------------------
  // BACKGROUND (copia del vanilla)
  // ---------------------------------------------------------------------------

  /**
   * Estira el fondo al tamano de la pantalla (de BACKGROUND_Y hasta abajo).
   */
  function fitBackground(bg:FlxSprite):Void
  {
    bg.setGraphicSize(FlxG.width, FlxG.height - BACKGROUND_Y);
    bg.updateHitbox();
    bg.x = 0;
    bg.y = BACKGROUND_Y;
  }

  function updateBackground(?previousLevelId:String = ''):Void
  {
    if (levelBackground == null || previousLevelId == '')
    {
      // Construye el fondo y lo muestra directo.
      levelBackground = currentLevel.buildBackground();
      fitBackground(levelBackground);
      levelBackground.zIndex = Z_BACKGROUND;
      levelBackground.alpha = 1.0;
      add(levelBackground);
    }
    else
    {
      var previousLevel = LevelRegistry.instance.fetchEntry(previousLevelId);

      if (currentLevel.isBackgroundSimple() && previousLevel.isBackgroundSimple())
      {
        var previousColor:FlxColor = previousLevel.getBackgroundColor();
        var currentColor:FlxColor = currentLevel.getBackgroundColor();
        if (previousColor != currentColor)
        {
          // Ambos son color solido: tween de color directo.
          FlxTween.cancelTweensOf(levelBackground);
          FlxTween.color(levelBackground, 0.9, levelBackground.color, currentColor, {ease: FlxEase.quartOut});
        }
      }
      else
      {
        // Fondo complejo: fade out del viejo y fade in del nuevo.
        var oldBackground:FlxSprite = levelBackground;
        FlxTween.tween(oldBackground, {alpha: 0.0}, 0.6, {
          ease: FlxEase.linear,
          onComplete: function(_)
          {
            remove(oldBackground);
          }
        });

        levelBackground = currentLevel.buildBackground();
        fitBackground(levelBackground);
        levelBackground.alpha = 0.0;
        levelBackground.zIndex = Z_BACKGROUND;
        add(levelBackground);

        FlxTween.tween(levelBackground, {alpha: 1.0}, 0.6, {ease: FlxEase.linear});
      }
    }
  }

  // ---------------------------------------------------------------------------
  // PROPS (copia del vanilla, sin la sintaxis `ind => prop`)
  // ---------------------------------------------------------------------------

  function updateProps():Void
  {
    var built = currentLevel.buildProps(levelProps.members);

    for (i in 0...built.length)
    {
      var prop = built[i];
      prop.x += (FullScreenScaleMode.gameCutoutSize.x * PROPS_WIDE_SHIFT);
      prop.zIndex = 1000;

      if (i < levelProps.members.length)
      {
        if (levelProps.members[i] != prop) levelProps.replace(levelProps.members[i], prop);
      }
      else
      {
        levelProps.add(prop);
      }
    }

    refresh();
  }
}
